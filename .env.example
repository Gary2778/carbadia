# 复制为 .env 用于本地开发:  cp .env.example .env
#
# SQLite 连接串。本地开发用相对路径即可;
# 生产环境必须指向持久卷,形如 file:/data/carbadia.db(容器启动脚本会校验前缀)。
DATABASE_URL="file:./dev.db"

# 会话 cookie 的 HMAC 签名密钥。本地 dev 有内置回退,可不设;
# 生产环境必须设置,否则拒绝启动。生成方式:openssl rand -hex 32
# SESSION_SECRET=

# 可选:设为 1 时不启动做市机器人
# BOT_DISABLED=

# 可选:历史成交/终态订单保留天数(仅清理机器人自成交,真人数据永久保留),默认 7
# RETENTION_DAYS=
