# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-retirement-qa/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client & local dev database
/src/generated
/prisma/*.db
/prisma/*.db-journal

# claude code local settings
.claude/settings.local.json

# superpowers brainstorm mockups
.superpowers/

# isolated feature worktrees
.worktrees/
.release-backups/

# obsidian:保留插件与外观设置,忽略每次开关文件都会变的窗口布局缓存
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.trash/

# 本地素材/个人文件,不入库
Blender/
wallpapers/
patch001.jpg
.playwright-mcp/

# 同目录下的另一个独立站点项目(cocoeco.io),不属于本仓库
cocoeco/

/.next-build-check/
