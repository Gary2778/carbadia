// 碳信用交易所 — 数据模型
// 货币与持仓: 现金用元(Float, 2位小数)，碳信用数量用整数(吨 CO2e)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("USER") // USER | ADMIN
  isBot        Boolean  @default(false)    // 做市机器人账户
  cashBalance  Float    @default(0)       // 可用现金(元)
  lockedCash   Float    @default(0)       // 挂单冻结现金
  createdAt    DateTime @default(now())

  holdings    Holding[]
  orders      Order[]
  buyTrades   Trade[]       @relation("BuyerTrades")
  sellTrades  Trade[]       @relation("SellerTrades")
  otcListings OtcListing[]  @relation("OtcSeller")
  otcDeals    OtcDeal[]     @relation("OtcBuyer")
}

// 碳信用资产 / 标的 (例如某个减排项目签发的核证减排量)
model Asset {
  id          String   @id @default(cuid())
  symbol      String   @unique          // 交易代码, 如 VCS-FOR-2021
  name        String                    // 项目名称
  standard    String                    // 核证标准: VCS / GS / CCER / CDM
  projectType String                    // 项目类型: 林业碳汇 / 可再生能源 / 甲烷回收 ...
  vintage     Int                       // 签发年份(vintage)
  country     String                    // 项目所在国家/地区
  registry    String                    // 登记簿
  description String   @default("")
  lastPrice   Float?                    // 最近成交价
  anchorPrice Float?                    // 机器人均值回归锚定价
  createdAt   DateTime @default(now())

  holdings    Holding[]
  orders      Order[]
  trades      Trade[]
  otcListings OtcListing[]
}

// 持仓
model Holding {
  id        String @id @default(cuid())
  userId    String
  assetId   String
  quantity  Int    @default(0) // 总持仓(吨)
  locked    Int    @default(0) // 挂卖单冻结

  user  User  @relation(fields: [userId], references: [id])
  asset Asset @relation(fields: [assetId], references: [id])

  @@unique([userId, assetId])
}

// 订单簿订单
model Order {
  id             String   @id @default(cuid())
  userId         String
  assetId        String
  side           String   // BUY | SELL
  type           String   // LIMIT | MARKET
  price          Float?   // 限价单价格; 市价单为 null
  quantity       Int      // 委托数量(吨)
  filledQuantity Int      @default(0)
  status         String   @default("OPEN") // OPEN | PARTIAL | FILLED | CANCELLED
  avgFillPrice   Float?
  createdAt      DateTime @default(now())

  user       User    @relation(fields: [userId], references: [id])
  asset      Asset   @relation(fields: [assetId], references: [id])
  buyTrades  Trade[] @relation("BuyOrder")
  sellTrades Trade[] @relation("SellOrder")

  @@index([assetId, side, status])
  @@index([userId, status])
}

// 成交记录
model Trade {
  id          String   @id @default(cuid())
  assetId     String
  buyOrderId  String
  sellOrderId String
  buyerId     String
  sellerId    String
  price       Float
  quantity    Int
  createdAt   DateTime @default(now())

  asset     Asset @relation(fields: [assetId], references: [id])
  buyOrder  Order @relation("BuyOrder", fields: [buyOrderId], references: [id])
  sellOrder Order @relation("SellOrder", fields: [sellOrderId], references: [id])
  buyer     User  @relation("BuyerTrades", fields: [buyerId], references: [id])
  seller    User  @relation("SellerTrades", fields: [sellerId], references: [id])

  @@index([assetId, createdAt])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
}

// OTC(场外/挂牌)出售挂单
model OtcListing {
  id          String   @id @default(cuid())
  sellerId    String
  assetId     String
  quantity    Int      // 剩余可售数量
  pricePerUnit Float   // 单价(元/吨)
  minQuantity Int      @default(1) // 最小购买量
  status      String   @default("ACTIVE") // ACTIVE | SOLD | CANCELLED
  createdAt   DateTime @default(now())

  seller User      @relation("OtcSeller", fields: [sellerId], references: [id])
  asset  Asset     @relation(fields: [assetId], references: [id])
  deals  OtcDeal[]

  @@index([assetId, status])
}

// OTC 成交
model OtcDeal {
  id        String   @id @default(cuid())
  listingId String
  buyerId   String
  quantity  Int
  price     Float    // 成交单价
  total     Float    // 成交总额
  createdAt DateTime @default(now())

  listing OtcListing @relation(fields: [listingId], references: [id])
  buyer   User       @relation("OtcBuyer", fields: [buyerId], references: [id])
}

// 第一方产品埋点:匿名漏斗事件(pageview/register/first_order/demo_login),90 天清理
model Event {
  id        String   @id @default(cuid())
  name      String
  path      String?
  visitorId String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

// 站内反馈(发布承接面)
model Feedback {
  id        String   @id @default(cuid())
  message   String
  contact   String?
  createdAt DateTime @default(now())
}
